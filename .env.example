# Public origin. Do not append /mcp.
CARDDAV_MCP_RESOURCE_URL=https://carddav-mcp.your-domain.example

# Logto-compatible issuer and Stalwart DAV origin.
CARDDAV_MCP_AUTHORIZATION_SERVER=https://login.your-domain.example/oidc
CARDDAV_MCP_STALWART_DAV_BASE_URL=https://dav.your-domain.example

# Public PKCE client returned by the constrained DCR shim.
CARDDAV_MCP_DCR_CLIENT_ID=replace-with-your-public-client-id

# Exact MCP-client callbacks. Keep only clients you intend to support.
CARDDAV_MCP_OAUTH_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,https://www.cursor.com/agents/mcp/oauth/callback,cursor://anysphere.cursor-mcp/oauth/callback,grokbot://mcp/oauth/callback,http://localhost:8787/callback,claude://claude.ai/oauth/callback,claude://oauth/callback,cowork://oauth/callback

# Optional: set only when Stalwart requires a different registered resource.
# CARDDAV_MCP_STALWART_AUDIENCE=https://carddav-mcp.your-domain.example

CARDDAV_MCP_LOG_FORMAT=json
RUST_LOG=carddav_mcp=info,tower_http=info,info
